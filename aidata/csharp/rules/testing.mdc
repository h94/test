## Unit Test — Service 層規則

直接 new Service，Mock 所有 IProvider 依賴

```csharp
public class UserServiceTests
{
    private readonly Mock<IUserProvider> _mockProvider = new();
    private readonly UserService _sut;

    public UserServiceTests()
    {
        _sut = new UserService(_mockProvider.Object);
    }

    // Happy Path
    [Fact]
    public async Task GetUserAsync_ValidId_ReturnsResponse()
    {
        _mockProvider
            .Setup(p => p.GetByIdAsync(1, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new UserDbModel { Id = 1, Name = "Test" });

        var result = await _sut.GetUserAsync(1, CancellationToken.None);

        result.Id.Should().Be(1);
    }

    // Error Path — Provider 回傳 null → Service 應拋出 ECException
    [Fact]
    public async Task GetUserAsync_NotFound_ThrowsECException()
    {
        _mockProvider
            .Setup(p => p.GetByIdAsync(It.IsAny<int>(), It.IsAny<CancellationToken>()))
            .ReturnsAsync((UserDbModel?)null);

        await Assert.ThrowsAsync<ECException>(() =>
            _sut.GetUserAsync(999, CancellationToken.None));
    }

    // Edge Case — 邊界輸入
    [Theory]
    [InlineData(0)]
    [InlineData(-1)]
    public async Task GetUserAsync_InvalidId_ThrowsECException(int id)
    {
        await Assert.ThrowsAsync<ECException>(() =>
            _sut.GetUserAsync(id, CancellationToken.None));
    }
}
```

