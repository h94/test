description: C# 測試規範（整合測試 / 單元測試）
globs: ["**/*Tests.cs", "**/*Test.cs", "**/Tests/**/*.cs"]
alwaysApply: false
---

## Testing Strategy

| 測試類型 | 測試對象 | Mock 目標 | 執行環境 |
|---------|---------|-----------|---------|
| Unit Test | Service 方法 | IProvider（+ IValidator、ITransfer 若需要） | 直接呼叫，無 HTTP |
| Integration Test | Controller 端點 | IService | in-memory（WebApplicationFactory）|

⛔ 不得使用 E2E 測試（呼叫已部署服務的真實端點）

---

## Integration Test — WebApplicationFactory 規則

**MUST** 使用 `WebApplicationFactory<Startup>` 啟動 in-memory test server
**MUST** Mock 所有 `IService` 並透過 `ConfigureServices` 覆蓋 DI
**MUST NOT** 使用 `new HttpClient()` 或硬寫 URL 指向已部署的 API

```csharp
public class UserControllerTests : IClassFixture<WebApplicationFactory<Startup>>
{
    private readonly WebApplicationFactory<Startup> _factory;

    public UserControllerTests(WebApplicationFactory<Startup> factory)
    {
        _factory = factory;
    }

    [Fact]
    public async Task GetUser_ValidId_Returns200()
    {
        // Arrange — mock IService，透過 DI 覆蓋注入
        var mockService = new Mock<IUserService>();
        mockService
            .Setup(s => s.GetUserAsync(1, It.IsAny<CancellationToken>()))
            .ReturnsAsync(new GetUserResponse { Id = 1, Name = "Test" });

        var client = _factory
            .WithWebHostBuilder(builder =>
                builder.ConfigureServices(services =>
                    services.AddSingleton(mockService.Object)))
            .CreateClient();

        // Act
        var response = await client.GetAsync("/api/user/getUserById?userId=1");

        // Assert
        response.StatusCode.Should().Be(HttpStatusCode.OK);
        var result = await response.Content.ReadFromJsonAsync<GetUserResponse>();
        result!.Id.Should().Be(1);
    }

    [Fact]
    public async Task GetUser_InvalidId_Returns4xx()
    {
        var mockService = new Mock<IUserService>();
        mockService
            .Setup(s => s.GetUserAsync(It.IsAny<int>(), It.IsAny<CancellationToken>()))
            .ThrowsAsync(ECException.BuildNotFound("user not found"));

        var client = _factory
            .WithWebHostBuilder(builder =>
                builder.ConfigureServices(services =>
                    services.AddSingleton(mockService.Object)))
            .CreateClient();

        var response = await client.GetAsync("/api/user/getUserById?userId=999");

        response.StatusCode.Should().Be(HttpStatusCode.NotFound);
    }
}
```

