    svg 
      symbol#paginationBullet(viewBox="0 0 50 10")
        circle(cx=5 cy=5 r=4 fill="#007aff")
    section.sportsBlock 
      article.swiper
        .swiper-wrapper
          each val,index in ballList 
            button.swiper-slide(class=index===0?"active":"")
              i(class=val.icon) 
              span= val.name
      i.arrow_ic.prev 
      i.arrow_ic.next 
    section.tabBlock
