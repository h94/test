                    input(type="checkbox")
                span 結果
                span 退水
                span 有效投注量
              div.checkBox 
                span 大總監
                  label
                    input(type="checkbox")
                span 結果
                span 退水
                span 有效投注量
              div 
                span 備註 
              div.checkBox.ballList 
